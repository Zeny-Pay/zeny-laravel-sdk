{
    "name": "usezeny/laravel",
    "description": "PHP and Laravel SDK for the Merchant API v1",
    "type": "library",
    "license": "MIT",
    "keywords": ["payments", "indonesia", "qris", "virtual-account", "sdk", "laravel"],
    "homepage": "https://github.com/Zeny-Pay/zeny-laravel-sdk",
    "support": {
        "issues": "https://github.com/Zeny-Pay/zeny-laravel-sdk/issues",
        "source": "https://github.com/Zeny-Pay/zeny-laravel-sdk"
    },
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/support": "^11.0|^12.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Zeny\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zeny\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Zeny\\Laravel\\ZenyServiceProvider"],
            "aliases": {
                "Zeny": "Zeny\\Laravel\\Facades\\Zeny"
            }
        }
    },
    "scripts": {
        "lint": "pint --test",
        "typecheck": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "pest",
        "sync:openapi": "@php scripts/sync-openapi.php",
        "generate": "@php scripts/generate-types.php",
        "check:generated": [
            "@php scripts/generate-types.php",
            "git diff --exit-code -- src/Generated"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
